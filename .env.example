# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (set automatically in docker-compose via DB_PASSWORD)
DATABASE_URL=postgresql://watchjunto:yourpassword@db:5432/watchjunto

# ─── Admin credentials ────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_now

# ─── App ──────────────────────────────────────────────────────────────────────
# Minimum 32 random chars — used to sign cookies
SECRET_KEY=change_me_to_a_long_random_string

PORT=3000
NODE_ENV=production

# ─── Docker Compose ───────────────────────────────────────────────────────────
# Used by docker-compose to build DATABASE_URL for the app service
DB_PASSWORD=yourpassword

# ─── Cloudflare Tunnel (optional) ─────────────────────────────────────────────
# Create a tunnel at https://one.dash.cloudflare.com → Networks → Tunnels
# Copy the token here to expose your app on the internet via Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=
